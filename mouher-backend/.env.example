DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_DATABASE_URL=

MEDUSA_BACKEND_URL=http://localhost:9000
MEDUSA_PUBLISHABLE_KEY=pk_your_publishable_key
MEDUSA_REGION_ID=reg_your_region_id
MEDUSA_COUNTRY_CODE=it
MEDUSA_CURRENCY_CODE=eur
MOUHER_STOREFRONT_PRODUCT_LIMIT=24
MOUHER_STOREFRONT_PRODUCT_FIELDS=id,title,handle,description,thumbnail,*images,*variants,*variants.calculated_price,*variants.prices,*categories,*collection,*tags

# Use one of these for protected Medusa Admin API calls.
MEDUSA_ADMIN_API_TOKEN=sk_your_admin_api_token
MEDUSA_ADMIN_BEARER_TOKEN=

# Required for Mouher warehouse/admin endpoints.
MOUHER_INTERNAL_API_TOKEN=change-me-internal-token

# Optional shared secret for operational payment webhooks sent to Django.
MOUHER_PAYMENT_WEBHOOK_SECRET=change-me-webhook-secret

# Configure this to a Medusa-enabled provider id such as pp_system_default,
# pp_stripe_stripe, or your SnapPay custom payment provider id.
MOUHER_DEFAULT_PAYMENT_PROVIDER_ID=pp_system_default

# Browser push notifications for loyalty updates in Chrome, Safari, Edge, etc.
MOUHER_WEB_PUSH_VAPID_PUBLIC_KEY=
MOUHER_WEB_PUSH_VAPID_PRIVATE_KEY=
MOUHER_WEB_PUSH_VAPID_SUBJECT=mailto:owner@mouher.com
