DATABASE_URL=postgres://mouher:mouher@localhost:5432/mouher_medusa
STORE_CORS=http://localhost:5173,https://pmembari.github.io
ADMIN_CORS=http://localhost:9000,http://localhost:7000,http://localhost:7001
AUTH_CORS=http://localhost:5173,https://pmembari.github.io,http://localhost:9000,http://localhost:7000,http://localhost:7001

# Generate unique local values, for example:
# openssl rand -hex 32
JWT_SECRET=change-me-jwt-secret
COOKIE_SECRET=change-me-cookie-secret

# Admin stays disabled unless explicitly enabled for trusted local development.
MEDUSA_ADMIN_DISABLED=true

MEDUSA_BACKEND_URL=http://localhost:9000
MEDUSA_REGION_ID=reg_your_region_id
MEDUSA_COUNTRY_CODE=ir
MEDUSA_CURRENCY_CODE=irr

# Optional fallback used only when Bonbast cannot be reached and no cached rate exists.
# Value is in toman, not rial.
FREE_SHIPPING_FALLBACK_TOMAN=

# Required only for server-side Admin API integrations.
MEDUSA_ADMIN_API_TOKEN=
MEDUSA_ADMIN_BEARER_TOKEN=

# Optional future loyalty/browser push provider settings.
MOUHER_WEB_PUSH_VAPID_PUBLIC_KEY=
MOUHER_WEB_PUSH_VAPID_PRIVATE_KEY=
MOUHER_WEB_PUSH_VAPID_SUBJECT=mailto:owner@mouher.com
