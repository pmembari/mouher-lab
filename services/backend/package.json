{
  "name": "mouher-medusa-backend",
  "version": "0.1.0",
  "private": true,
  "description": "Mouher Medusa backend service.",
  "scripts": {
    "build": "medusa build",
    "dev": "medusa develop",
    "test": "vitest run src",
    "test:analytics": "vitest run src/modules/analytics src/api/store/analytics src/api/admin/analytics",
    "catalog:dry-run": "medusa exec ./src/scripts/import-mouher-catalog.ts",
    "catalog:import": "medusa exec ./src/scripts/import-mouher-catalog.ts -- --apply",
    "test:catalog-import": "vitest run src/lib/catalog-import.test.ts"
  },
  "dependencies": {
    "@medusajs/framework": "^2.16.0",
    "@medusajs/medusa": "^2.16.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  }
}
